{
  "manifest_version": 3,
  "name": "Bionic Web Reader",
  "version": "1.0.0",
  "description": "Convert webpage text into Bionic Reading format.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ]
}
